{
  "name": "harness-store",
  "version": "0.0.0",
  "private": true,
  "description": "Harness Store monorepo: desktop app (Runtime + Model Gateway), Store backend, Manifest package, SDK and reference Harnesses.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive run lint && pnpm run lint:root && pnpm run format:check",
    "lint:root": "eslint \"*.{js,mjs,cjs}\" \"scripts/*.mjs\"",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "e2e": "pnpm build && pnpm --filter @harness-store/desktop run e2e",
    "check:catalogs": "pnpm --filter @harness-store/desktop exec vitest run test/i18n/catalogs.test.ts",
    "ci:local": "node scripts/ci-local.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
