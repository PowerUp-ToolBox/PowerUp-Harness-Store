# The environment config.toml reads with env(...). `pnpm db:start` (scripts/supabase.ts) uses these
# values for any variable that is neither set in the environment nor in supabase/.env, so the local
# stack and CI need no setup. They are not secrets: they point the GitHub provider at the fake
# GitHub the store tests start (test-store/fake-github.ts) on the stack's Docker network.
#
# To sign in with real GitHub locally, copy this file to supabase/.env (gitignored), put an OAuth
# app's client id and secret in it (callback URL http://127.0.0.1:54321/auth/v1/callback) and
# leave SUPABASE_AUTH_EXTERNAL_GITHUB_URL empty.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=fake-github-client
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=fake-github-secret
SUPABASE_AUTH_EXTERNAL_GITHUB_URL=http://fake-github:8080
