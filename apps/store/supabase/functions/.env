# The environment of the Edge Functions on the local stack (`supabase functions serve` and
# `supabase start` read this file). Not secrets, and not used by a deployed Store, whose function
# secrets are set with `supabase secrets set`.
#
# The origin the desktop app reaches the Store at: `download` puts it in its signed URLs, since
# SUPABASE_URL inside the edge runtime is the gateway's address on the stack's Docker network.
STORE_PUBLIC_URL=http://127.0.0.1:54321
# Test-only: a signed download URL lives this many seconds instead of 60 (1 to 60; anything else
# is 60), so the store tests can watch one expire (test-store/download.test.ts). Never set it in a
# deployed Store.
DOWNLOAD_URL_TTL_SECONDS=5
