{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // The modules in supabase/functions/_shared are imported by Deno too, which needs the real
    // `.ts` extension in relative imports.
    "allowImportingTsExtensions": true
  },
  // The Deno.serve entry files under supabase/functions/<name>/ are Deno-only and left out; the
  // store tests (test-store/) exercise them over HTTP.
  "include": ["scripts", "supabase/functions/_shared/**/*.ts", "test", "test-store", "*.config.ts"]
}
