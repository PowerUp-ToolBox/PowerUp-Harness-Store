{
  "name": "@harness-store/desktop",
  "productName": "Harness Store",
  "version": "0.0.0",
  "private": true,
  "description": "Harness Store desktop app: Electron shell whose main process is the Runtime and hosts the Model Gateway.",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder",
    "lint": "eslint .",
    "typecheck": "tsc --build tsconfig.json tsconfig.web.json",
    "test": "vitest run",
    "test:i18n": "vitest run i18n",
    "test:runtime-bootstrap": "vitest run runtime-bootstrap",
    "test:connectivity": "vitest run connectivity",
    "test:onboarding": "vitest run onboarding",
    "test:connections": "vitest run connections",
    "test:bindings": "vitest run bindings",
    "test:auth": "vitest run auth sign-in",
    "test:install": "vitest run install",
    "test:launch": "vitest run launch",
    "test:publish": "vitest run publish",
    "test:usage": "vitest run usage",
    "test:settings": "vitest run settings",
    "test:report": "vitest run report",
    "test:store-browsing": "vitest run store-home store-assets store-search store-detail store-publisher render-markdown primary-action tags"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@harness-store/gateway": "workspace:*",
    "@harness-store/manifest": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.17",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "fflate": "^0.8.3",
    "ignore": "^7.0.5",
    "intl-messageformat": "12.1.3",
    "jsdom": "^30.1.3",
    "marked": "18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "semver": "^7.8.5",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "node-pty": "1.2.0-beta.15"
  }
}
