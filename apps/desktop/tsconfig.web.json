{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Renderer (sandboxed React UI): DOM and JSX, no Node types",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.web.tsbuildinfo"
  },
  "include": ["src/renderer/src", "src/shared", "test/renderer"]
}
