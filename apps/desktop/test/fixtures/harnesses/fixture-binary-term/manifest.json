{
  "manifestVersion": 1,
  "id": "acme/fixture-binary-term",
  "version": "1.0.0",
  "name": "Fixture Binary Term",
  "summary": "A binary terminal Harness for the Runtime's tests.",
  "license": "MIT",
  "platforms": ["darwin-arm64", "darwin-x64", "linux-x64", "linux-arm64"],
  "runtime": {
    "kind": "binary"
  },
  "entry": {
    "darwin-arm64": "bin/fixture-binary-term",
    "darwin-x64": "bin/fixture-binary-term",
    "linux-x64": "bin/fixture-binary-term",
    "linux-arm64": "bin/fixture-binary-term"
  },
  "ui": {
    "kind": "terminal"
  },
  "workspace": "none",
  "models": {
    "slots": {
      "default": {
        "description": "Answers the test's messages."
      }
    }
  },
  "permissions": {
    "filesystem": {
      "scope": "none"
    },
    "shell": false,
    "network": {
      "domains": []
    }
  }
}
