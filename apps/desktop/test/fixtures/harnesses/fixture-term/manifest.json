{
  "manifestVersion": 1,
  "id": "acme/fixture-term",
  "version": "1.0.0",
  "name": "Fixture Term",
  "summary": "A terminal Harness for the Runtime's tests.",
  "license": "MIT",
  "platforms": [
    "darwin-arm64",
    "darwin-x64",
    "linux-x64",
    "linux-arm64",
    "win32-x64",
    "win32-arm64"
  ],
  "runtime": {
    "kind": "node",
    "node": "22"
  },
  "entry": "index.mjs",
  "ui": {
    "kind": "terminal"
  },
  "workspace": "none",
  "models": {
    "slots": {
      "default": {
        "description": "Answers the test's messages."
      }
    }
  },
  "permissions": {
    "filesystem": {
      "scope": "none"
    },
    "shell": false,
    "network": {
      "domains": []
    }
  }
}
