{
  "manifestVersion": 1,
  "id": "acme/fixture-web",
  "version": "1.0.0",
  "name": "Fixture Web",
  "summary": "A web Harness for the Runtime's tests.",
  "license": "MIT",
  "platforms": [
    "darwin-arm64",
    "darwin-x64",
    "linux-x64",
    "linux-arm64",
    "win32-x64",
    "win32-arm64"
  ],
  "runtime": { "kind": "node", "node": "22" },
  "entry": "index.mjs",
  "ui": { "kind": "web" },
  "workspace": "none",
  "models": { "slots": { "default": { "description": "Answers the test's messages." } } },
  "permissions": {
    "filesystem": { "scope": "none" },
    "shell": false,
    "network": { "domains": [] }
  }
}
