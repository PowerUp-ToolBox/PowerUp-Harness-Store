{
  "name": "@harness-store/gateway",
  "version": "0.0.0",
  "private": true,
  "description": "The Model Gateway: loopback OpenAI-compatible HTTP server that resolves Model Slots and forwards to Providers.",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing/fake-provider": {
      "types": "./dist/testing/fake-provider.d.ts",
      "default": "./dist/testing/fake-provider.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.80",
    "ai": "^7.0.155",
    "openai": "^7.45.1",
    "zod": "^4.6.7"
  }
}
