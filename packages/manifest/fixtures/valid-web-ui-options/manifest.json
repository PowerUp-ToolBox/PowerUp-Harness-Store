{
  "manifestVersion": 1,
  "id": "alice/hello-web",
  "version": "0.1.0",
  "name": "Hello Web",
  "summary": "A minimal web-UI harness that says hello with your model.",
  "tags": ["fun"],
  "license": "MIT",
  "platforms": ["darwin-arm64", "darwin-x64", "win32-x64", "linux-x64"],
  "runtime": {
    "kind": "node",
    "node": "22"
  },
  "entry": "server/main.mjs",
  "ui": {
    "kind": "web",
    "path": "/app",
    "readyTimeoutSeconds": 120,
    "window": {
      "width": 1100,
      "height": 760
    }
  },
  "workspace": "optional",
  "models": {
    "slots": {
      "default": {
        "requirements": {
          "tools": false
        }
      }
    }
  },
  "permissions": {
    "filesystem": {
      "scope": "workspace",
      "paths": []
    },
    "shell": false,
    "network": {
      "any": true
    }
  }
}
